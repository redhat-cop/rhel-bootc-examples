# Real-time RHEL 10.2 bootc image: kernel-rt plus the stock tuned `realtime` profile, with the
# profile's kernel arguments baked into /usr/lib/bootc/kargs.d so tuned 2.27 — which has no
# bootc-aware bootloader path — finds them already set and appends nothing. README.md explains the
# silent duplicate-isolcpus failure that prevents, and why this is scoped to RHEL 10.2.
FROM registry.redhat.io/rhel10/rhel-bootc:10.2

# kernel-rt comes from rhel-10-for-x86_64-rt-rpms (rhel-10-for-x86_64-rt-eus-rpms on an EUS
# subscription), so the build host's subscription must include RHEL for Real Time.
#
# --releasever=10.2 pins the CDN to the 10.2 minor, and it matters: the rolling `10` stream already
# serves el10_3 kernel-rt and tuned 2.28. Unpinned, this would install a 10.3 kernel-rt onto the 10.2
# base whose own kernel is removed just below — a kernel/userspace mismatch — and tuned 2.28 changes
# the very kernel-argument behaviour this example is built around. The tuned assertion re-checks that
# at build time instead of trusting the pin alone.
RUN set -eu; \
    dnf -y --releasever=10.2 remove kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra; \
    dnf -y --releasever=10.2 --enablerepo=rhel-10-for-x86_64-rt-rpms install \
      kernel-rt kernel-rt-modules-extra tuned tuned-profiles-realtime realtime-tests stress-ng; \
    rpm -q --qf '%{VERSION}\n' tuned | grep -qx '2\.27\..*' \
      || { echo "tuned $(rpm -q tuned) is not 2.27; this example is only verified for tuned 2.27 (RHEL 10.2)"; exit 1; }; \
    for d in /usr/lib/modules/*; do [ -e "$d/vmlinuz" ] || rm -rf "$d"; done; \
    find /boot -mindepth 1 -delete; \
    test "$(ls /usr/lib/modules | wc -l)" = 1; \
    ls /usr/lib/modules/*/initramfs.img; \
    dnf clean all; rm -rf /var/{cache,log} /var/lib/{dnf,rhsm}

# Tuning tree (see README.md): realtime profile variables, the matching kargs.d file, and RLIMIT_RTPRIO
# so rootless applications can use SCHED_FIFO. select-declarative/ is the profile selection: tuned's own
# recommend.d plus profile_mode=auto, which engages on a fresh install. select-unit/ is the alternative
# for hosts that already carry machine-local tuned state.
COPY tune/ /
COPY select-declarative/ /

RUN bootc container lint
